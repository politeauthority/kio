# Local dev — points at q-postgres (192.168.50.89) with kio_dev database.
# Get password: kubectl get secret -n q-postgres kio-dev-postgres-user -o jsonpath='{.data.password}' | base64 -d
DATABASE_URL=postgresql+asyncpg://kio_dev:CHANGE_ME@localhost:5432/kio_dev
MQTT_HOST=192.168.50.86
MQTT_PORT=1883

# Auth — set AUTH_DISABLED=true for local dev to skip all dashboard auth checks.
# In production: remove AUTH_DISABLED and configure one or both of:
#   - Authentik (OIDC): AUTHENTIK_ISSUER + AUTHENTIK_CLIENT_ID
#   - Static dev login: DEV_USERNAME + DEV_PASSWORD (break-glass / CI)
# The UI discovers what is enabled via GET /auth/config.
AUTH_DISABLED=true
# Authentik OIDC issuer URL (Applications > Your App > OpenID Connect > Issuer URL)
# e.g. https://auth.example.com/application/o/kio/
AUTHENTIK_ISSUER=
# Client ID of the kio application in Authentik (public/PKCE client, no secret).
# Also enforced as the JWT `aud` claim when set.
AUTHENTIK_CLIENT_ID=
# Label for the login button: "Sign in with <name>"
AUTHENTIK_DISPLAY_NAME=Authentik
# Static username/password for POST /auth/login. Leave blank to disable.
DEV_USERNAME=
DEV_PASSWORD=
# Comma-separated static API keys for HACS / scripts (e.g. kio_abc123,kio_def456)
API_KEYS=
# Expose interactive API docs at /docs, /redoc, /openapi.json. Off by default
# (locked down in prod); handy to enable locally.
DOCS_ENABLED=true
