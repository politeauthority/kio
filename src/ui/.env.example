# OIDC auth is normally configured on the API (AUTHENTIK_ISSUER /
# AUTHENTIK_CLIENT_ID) and discovered by the UI via GET /auth/config — nothing
# to set here. These are only a fallback used when the API's /auth/config is
# unreachable, and can stay blank.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=

# Show the Feature Flags settings page. Set to "True" to enable.
# VITE_SHOW_FEATURE_FLAGS is used by the Vite dev server (npm run dev).
# SHOW_FEATURE_FLAGS is injected at container startup by docker-entrypoint.sh.
VITE_SHOW_FEATURE_FLAGS=True
